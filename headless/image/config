# pi-gen configuration for the Pacemaker Box image (Raspberry Pi OS Lite, 64-bit).
# build-image.sh copies this next to a pi-gen checkout. Values can be overridden with environment variables.
IMG_NAME=pacemaker-box
RELEASE=bookworm
ENABLE_SSH=1
FIRST_USER_NAME=pacemaker-admin
# Set a real password (or use FIRST_USER_PASS from the environment) before shipping an image.
FIRST_USER_PASS=changeme-on-first-login
DISABLE_FIRST_BOOT_USER_RENAME=1
LOCALE_DEFAULT=en_GB.UTF-8
TARGET_HOSTNAME=pacemaker
# Lite = stages 0 to 2, plus ours. Stage 2 must not export its own image.
STAGE_LIST="stage0 stage1 stage2 stage-pacemaker"
DEPLOY_COMPRESSION=xz
